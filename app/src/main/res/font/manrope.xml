<?xml version="1.0" encoding="utf-8"?>
<!--
  Manrope (SIL Open Font License) — the geometric sans the whole UI is set in.
  One variable TTF serves every weight; textStyle="bold" resolves to the 700 entry,
  and hero numbers/titles request 800 via android:fontVariationSettings.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/manrope_variable" android:fontWeight="400" android:fontStyle="normal"
        android:fontVariationSettings="'wght' 400"
        app:font="@font/manrope_variable" app:fontWeight="400" app:fontStyle="normal"
        app:fontVariationSettings="'wght' 400" />
    <font
        android:font="@font/manrope_variable" android:fontWeight="500" android:fontStyle="normal"
        android:fontVariationSettings="'wght' 500"
        app:font="@font/manrope_variable" app:fontWeight="500" app:fontStyle="normal"
        app:fontVariationSettings="'wght' 500" />
    <font
        android:font="@font/manrope_variable" android:fontWeight="600" android:fontStyle="normal"
        android:fontVariationSettings="'wght' 600"
        app:font="@font/manrope_variable" app:fontWeight="600" app:fontStyle="normal"
        app:fontVariationSettings="'wght' 600" />
    <font
        android:font="@font/manrope_variable" android:fontWeight="700" android:fontStyle="normal"
        android:fontVariationSettings="'wght' 700"
        app:font="@font/manrope_variable" app:fontWeight="700" app:fontStyle="normal"
        app:fontVariationSettings="'wght' 700" />
    <font
        android:font="@font/manrope_variable" android:fontWeight="800" android:fontStyle="normal"
        android:fontVariationSettings="'wght' 800"
        app:font="@font/manrope_variable" app:fontWeight="800" app:fontStyle="normal"
        app:fontVariationSettings="'wght' 800" />
</font-family>
