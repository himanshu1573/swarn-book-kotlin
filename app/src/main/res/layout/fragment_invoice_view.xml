<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="32dp">

            <!-- Top bar: back, title, status pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBack"
                    style="@style/Widget.SwarnaBook.IconButton.Outline"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/back"
                    app:icon="@drawable/ic_arrow_back" />

                <TextView
                    android:id="@+id/headerTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/invoice"
                    android:textColor="@color/ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statusPill"
                    style="@style/Text.SwarnaBook.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    tools:background="@drawable/bg_pill_success"
                    tools:text="Paid"
                    tools:textColor="@color/success" />
            </LinearLayout>

            <!-- The "paper" invoice -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SwarnaBook.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:contentPadding="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Gold strip: the one place the metal colour leads -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:background="@drawable/gold_gradient" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Shop header + invoice meta -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:baselineAligned="false">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/shopName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/ink"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    tools:text="Anukul Jewellers" />

                                <TextView
                                    android:id="@+id/shopAddress"
                                    style="@style/Text.SwarnaBook.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    tools:text="123 Bazaar Road, Unnao" />

                                <TextView
                                    android:id="@+id/shopMeta"
                                    style="@style/Text.SwarnaBook.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="Ph: +91 98765 43210 | GSTIN: 09ABCDE1234F1Z5" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Text.SwarnaBook.Eyebrow"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/invoice"
                                    android:textColor="@color/indigo" />

                                <TextView
                                    android:id="@+id/invoiceNumber"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/ink"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    tools:text="#INV-001" />

                                <TextView
                                    android:id="@+id/invoiceDate"
                                    style="@style/Text.SwarnaBook.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="29/06/2026" />
                            </LinearLayout>
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:layout_marginVertical="14dp" android:background="@color/outline" />

                        <!-- Customer -->
                        <TextView
                            style="@style/Text.SwarnaBook.Eyebrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/billed_to" />

                        <TextView
                            android:id="@+id/customerLine"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/ink"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="Anita Sharma  |  9876500011" />

                        <!-- Items table header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_table_header"
                            android:orientation="horizontal"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="8dp">

                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="2.4" android:text="Item" android:textStyle="bold"
                                android:textSize="11sp" android:textColor="@color/text_secondary" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Wt(g)" android:textStyle="bold"
                                android:textSize="11sp" android:textColor="@color/text_secondary" android:gravity="end" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1.2" android:text="Rate" android:textStyle="bold"
                                android:textSize="11sp" android:textColor="@color/text_secondary" android:gravity="end" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1.2" android:text="Making" android:textStyle="bold"
                                android:textSize="11sp" android:textColor="@color/text_secondary" android:gravity="end" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1.4" android:text="Total" android:textStyle="bold"
                                android:textSize="11sp" android:textColor="@color/text_secondary" android:gravity="end" />
                        </LinearLayout>

                        <!-- Dynamic item rows injected here -->
                        <LinearLayout
                            android:id="@+id/itemsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:layout_marginVertical="12dp" android:background="@color/outline" />

                        <!-- Totals -->
                        <LinearLayout
                            android:id="@+id/totalsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <!-- Notes + signature -->
                        <TextView
                            android:id="@+id/notesView"
                            style="@style/Text.SwarnaBook.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            tools:text="Notes: Advance received in cash." />

                        <TextView
                            style="@style/Text.SwarnaBook.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="28dp"
                            android:text="@string/authorized_signature" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Actions: one indigo primary, then pills -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkPaid"
                style="@style/Widget.SwarnaBook.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/mark_as_paid"
                app:icon="@drawable/ic_check" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWhatsapp"
                    style="@style/Widget.SwarnaBook.Button.Success"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:text="@string/send_whatsapp"
                    app:icon="@drawable/ic_whatsapp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShare"
                    style="@style/Widget.SwarnaBook.Button.Outline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="@string/share_pdf"
                    app:icon="@drawable/ic_share" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrint"
                    style="@style/Widget.SwarnaBook.Button.Outline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:text="@string/print"
                    app:icon="@drawable/ic_print" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEdit"
                    style="@style/Widget.SwarnaBook.Button.Outline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="@string/edit_invoice"
                    app:icon="@drawable/ic_edit" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
